/*
 * Station UI components - Docs/UIDesign.MD sections 2 and 6.
 *
 * Everything here is square-cornered, flat-filled and bordered in --ink. The only circle in the UI is the roundel,
 * which draws itself. Values that appear in more than one place live in tokens.uss.
 */

/* ---- signage: a dark band with a line-colour rule beneath it ---- */

.band {
    min-height: var(--signage-band-min);
    background-color: var(--ink);
    padding-left: var(--screen-margin);
    padding-right: var(--screen-margin);
    padding-top: 24px;
    padding-bottom: 24px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.band__rule {
    height: var(--signage-rule);
    flex-shrink: 0;
}

/* Signage wraps and grows; it never ellipsises, because a truncated station name is worse than a tall one (3.3). */
.signage {
    white-space: normal;
    color: var(--ink);
    letter-spacing: var(--tracking-signage);
}

.signage--onDark { color: var(--paper); }
.signage--dim { color: var(--ink-dim); }

.body {
    white-space: normal;
    color: var(--ink);
}

.body--dim { color: var(--ink-dim); }

/* Tabular figures: the clock must not reflow as its digits change (section 6). */
.numerals { -unity-text-align: middle-right; }

/* ---- surfaces ---- */

.card {
    background-color: #FFFFFF;
    border-left-width: var(--border-width);
    border-right-width: var(--border-width);
    border-top-width: var(--border-width);
    border-bottom-width: var(--border-width);
    border-left-color: var(--ink);
    border-right-color: var(--ink);
    border-top-color: var(--ink);
    border-bottom-color: var(--ink);
    flex-shrink: 0;
}

.scrim { background-color: rgba(31, 35, 33, 0.65); }

.screen {
    flex-grow: 1;
    background-color: var(--paper);
}

/* A screen that sits over the 3D board leaves the middle alone. */
.screen--transparent {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

/* ---- buttons ---- */

.button {
    min-height: 132px;
    background-color: #FFFFFF;
    color: var(--ink);
    border-left-width: var(--border-width);
    border-right-width: var(--border-width);
    border-top-width: var(--border-width);
    border-bottom-width: var(--border-width);
    border-left-color: var(--ink);
    border-right-color: var(--ink);
    border-top-color: var(--ink);
    border-bottom-color: var(--ink);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    margin: 0;
    padding-left: 32px;
    padding-right: 32px;
    white-space: normal;
    letter-spacing: 3px;
}

.button:hover { background-color: #F0F1EE; }
.button:active { background-color: var(--ink); color: var(--paper); }
.button:disabled { opacity: 0.4; }

/*
 * A screen on its way out is disabled so a button cannot be hit while it fades - GameFlow throws on a transition
 * it did not expect. The fade owns the opacity for those 260 ms, so the disabled dimming must not join in.
 */
.screen--leaving .button:disabled { opacity: 1; }

/* The one filled button on a screen: the thing the player came to do. */
.button--primary {
    background-color: var(--ink);
    color: var(--paper);
}

.button--primary:hover { background-color: #2B302D; }

/* A small square icon button, e.g. pause. */
.button--icon {
    min-height: 96px;
    width: 96px;
    padding-left: 0;
    padding-right: 0;
}

/* ---- the LED strip ---- */

.led-strip {
    background-color: var(--led-ground);
    flex-shrink: 0;
    overflow: hidden;
}

/*
 * The tutorial's speech bubble. The card itself is .card (white, 4px --ink); this only floats it and sizes its
 * type. The tail is painted by the element, because USS cannot make a triangle.
 *
 * 44px is deliberately larger than any other body copy in the game: it is the only text a player is expected to
 * stop and read, and it is read against a 3D board rather than a flat screen ground.
 */
.callout {
    position: absolute;
    max-width: 640px;
}

.callout__card {
    padding-top: 26px;
    padding-bottom: 26px;
    padding-left: 30px;
    padding-right: 30px;
}

.callout__text {
    white-space: normal;
    font-size: 44px;
    color: var(--ink);
}

/* ---- the roundel ---- */

.station-roundel { flex-shrink: 0; }

/*
 * The line-liveried button: the one thing the player came to do, wearing the line instead of the ink. The shell
 * paints the background through .line-bg, so this rule owns only the text, and the press state is opacity rather
 * than a background swap -- an inline background beats a USS one, so :active could not repaint it anyway.
 */
.button--line { color: var(--ink); }
.button--line:hover { opacity: 0.92; }
.button--line:active { opacity: 0.72; }

/* ---- the concourse ---- */

/* One dot per station, drawn by LineProgressStrip. Height is set by the screen; this is only the floor. */
.line-progress { flex-shrink: 0; }

/* The platform scene. Everything inside is positioned as a percentage of it, so only the height is set. */
.platform-art { flex-shrink: 1; }

/*
 * The station name board: the light counterpart of .band. Paper on paper, held apart by the .card border it
 * inherits, with the line-colour rule inside the bottom edge rather than under the card.
 */
.sign-card {
    margin-left: var(--screen-margin);
    margin-right: var(--screen-margin);
    margin-top: 28px;
    background-color: #FFFFFF;
}

.sign-card__row {
    flex-direction: row;
    align-items: center;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 30px;
    padding-bottom: 30px;
}

.sign-card__rule {
    height: var(--signage-rule);
    flex-shrink: 0;
}

/* The three utility buttons under the two big ones. */
.icon-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 22px;
}

.icon-row .button--icon {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-height: 116px;
    margin-left: 18px;
}
