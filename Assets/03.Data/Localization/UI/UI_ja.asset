  - m_Id: 296786441789440
    m_Localized: "\u3084\u3084\u9045\u308C"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983744
    m_Localized: "\u9045\u5EF6"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983745
    m_Localized: "\u3053\u306E \u30DE\u30B9\u3092 \u30BF\u30C3\u30D7\u3057\u307E\u3059\u3002\u6B21\u306E \u7DDA\u8DEF\u306F \u3053\u3053\u3067\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983746
    m_Localized: "\u7DDA\u8DEF\u304C \u5411\u304B\u3046\u5148\u306E \u30DE\u30B9\u3092 \u30BF\u30C3\u30D7\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983747
    m_Localized: "\u3064\u3065\u3051\u3066\u3001\u3082\u3046\u4E00\u65B9\u306E \u5074\u3092 \u30BF\u30C3\u30D7\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983748
    m_Localized: "\u6570\u5B57\u306F \u7DDA\u8DEF\u306E \u672C\u6570\u3067\u3059\u3002\u3053\u306E \u5217\u306F \u3061\u3087\u3046\u3069 \u305D\u306E\u6570\u306B \u306A\u308A\u307E\u3057\u305F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983749
    m_Localized: "\u6570\u5B57\u304C \u8D64\u306B \u306A\u308A\u307E\u3057\u305F\u3002\u7DDA\u8DEF\u304C \u591A\u3059\u304E\u307E\u3059\u3002\u9577\u62BC\u3057\u3067 \u53D6\u308A\u9664\u304D\u307E\u3057\u3087\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983750
    m_Localized: "\u305D\u306E\u8ABF\u5B50\u3067\u3059\u3002\u8F2A\u306E \u793A\u3059\u5148\u3092 \u305F\u3069\u3063\u3066 \u7D42\u70B9\u307E\u3067\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983751
    m_Localized: "\u305D\u308C\u306F \u521D\u3081\u304B\u3089 \u6577\u304B\u308C\u305F \u7DDA\u8DEF\u3067\u3059\u3002\u81EA\u5206\u3067 \u7F6E\u3044\u305F \u7DDA\u8DEF\u3092 \u9577\u62BC\u3057 \u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983752
    m_Localized: "\u305D\u306E \u5217\u306F \u7DDA\u8DEF\u304C \u591A\u3059\u304E\u307E\u3059\u3002\u9577\u62BC\u3057\u3067 \u4E00\u3064 \u53D6\u308A\u9664\u3044\u3066 \u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983753
    m_Localized: "\u3053\u3053\u306B \u7F6E\u3051\u308B \u7DDA\u8DEF\u306F \u4E00\u3064\u3060\u3051\u3002\u30BF\u30C3\u30D7 \u3059\u308B\u3060\u3051\u3067 \u7F6E\u304B\u308C\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983755
    m_Localized: "\u6B21\u306E \u7DDA\u8DEF\u306F \u3053\u3053\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983756
    m_Localized: "\u3053\u3061\u3089\u3078\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983757
    m_Localized: "\u307E\u305A\u306F \u3053\u3061\u3089\u304B\u3089\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983758
    m_Localized: "\u308F\u3056\u3068 \u9593\u9055\u3048\u3066 \u307F\u307E\u3057\u3087\u3046\u3002\u3053\u306E \u30DE\u30B9\u3092 \u30BF\u30C3\u30D7\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983759
    m_Localized: "\u8DEF\u7DDA"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983760
    m_Localized: "Ashgate \u306B\u306F \u307E\u3060 \u7DDA\u8DEF\u304C \u3042\u308A\u307E\u305B\u3093\u3002\u4E00\u30DE\u30B9\u306B \u4E00\u3064\u305A\u3064 \u7F6E\u304D\u3001S \u306E \u30C8\u30F3\u30CD\u30EB\u304B\u3089 E \u306E \u30C8\u30F3\u30CD\u30EB\u307E\u3067 \u3064\u306A\u304E\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983761
    m_Localized: "\u6570\u5B57"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983762
    m_Localized: "\u6570\u5B57\u306F \u305D\u306E\u884C\u30FB\u5217\u306B \u7F6E\u304F \u7DDA\u8DEF\u306E \u672C\u6570\u3067\u3059\u3002\u3061\u3087\u3046\u3069 \u305D\u306E\u6570\u306B \u306A\u308B\u3068 \u7DD1\u3001\u8D85\u3048\u308B\u3068 \u8D64\u306B \u306A\u308A\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983763
    m_Localized: "\u767A\u8ECA"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983764
    m_Localized: "S \u304B\u3089 E \u307E\u3067 \u3064\u306A\u304C\u308A\u3001\u3059\u3079\u3066\u306E \u6570\u5B57\u304C \u305D\u308D\u3046\u3068 \u5217\u8ECA\u304C \u8D70\u308A\u307E\u3059\u3002\u6642\u9593\u306F \u661F\u306E \u6570\u3092 \u6C7A\u3081\u308B\u3060\u3051\u3067\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983765
    m_Localized: "\u3064\u304E\u3078"
    m_Metadata:
      m_Items: []
  - m_Id: 296786445983766
