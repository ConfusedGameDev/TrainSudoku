  - m_Id: 3504017409
    m_Localized: '{0} / {1} COMPLETADAS'
    m_Metadata:
      m_Items: []
  - m_Id: 3504017410
    m_Localized: "Elige una estaci\xF3n en la plataforma"
    m_Metadata:
      m_Items: []
  - m_Id: 3504017411
    m_Localized: CONTINUAR
    m_Metadata:
      m_Items: []
  - m_Id: 3504017412
