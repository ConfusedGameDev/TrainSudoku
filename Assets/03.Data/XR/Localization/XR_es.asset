    m_Metadata:
      m_Items: []
  - m_Id: 3504017413
    m_Localized: CONTINUAR
    m_Metadata:
      m_Items: []
  - m_Id: 3504017414
    m_Localized: "Reintentar, el mapa y los ajustes est\xE1n en el men\xFA de la mu\xF1eca"
    m_Metadata:
      m_Items: []
  - m_Id: 3504017415
    m_Localized: LLEGADA
    m_Metadata:
      m_Items: []
  - m_Id: 3504017416
    m_Localized: ESTA VUELTA  {0}
    m_Metadata:
      m_Items: []
  - m_Id: 3504017417
    m_Localized: MEJOR  {0}
    m_Metadata:
      m_Items: []
